# ════════════════════════════════════════════════════════════════
# BioTime Colombia - Configuración de entorno
# Copia este archivo como .env y ajusta los valores
# ════════════════════════════════════════════════════════════════

# ── BioTime 8.0 Colombia ─────────────────────────────────────────
# URL del servidor BioTime (sin / al final)
BIOTIME_BASE_URL=http://192.168.1.100:8000
BIOTIME_USERNAME=admin
BIOTIME_PASSWORD=admin123
BIOTIME_TIMEOUT=30
BIOTIME_PAGE_SIZE=500
# Poner False si el servidor BioTime tiene SSL self-signed
BIOTIME_VERIFY_SSL=False

# ── Turno y tolerancia ────────────────────────────────────────────
# Minutos de gracia antes de marcar como tarde (ley colombiana: generalmente 15)
GRACE_PERIOD_MINUTES=15

# ── Ventana de monitoreo ──────────────────────────────────────────
# El monitor solo actúa entre estas horas (Colombia)
MONITOR_START_TIME=05:30
MONITOR_END_TIME=12:00
# Cada cuántos segundos se consulta BioTime (60 = cada minuto)
POLL_INTERVAL_SECONDS=60

# ── WhatsApp (Evolution API) ──────────────────────────────────────
WHATSAPP_ENABLED=true
EVOLUTION_API_URL=https://evolution.tudominio.com
EVOLUTION_API_KEY=tu_api_key_de_evolution
EVOLUTION_INSTANCE=nombre_instancia_whatsapp

# ── Email SMTP ────────────────────────────────────────────────────
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notificaciones@tuempresa.com
SMTP_PASSWORD=tu_contraseña_smtp
SMTP_FROM=Asistencia MG Technology <notificaciones@tuempresa.com>
SMTP_TLS=true

# ── Destinatarios administrativos ────────────────────────────────
# Reciben copia de CADA notificación de llegada tarde
ADMIN_EMAILS=rrhh@tuempresa.com,gerencia@tuempresa.com
ADMIN_PHONES=573001234567,573009876543

# ── API interna ───────────────────────────────────────────────────
# Cambiar por una clave segura en producción
API_KEY=mi_clave_segura_123
DEBUG=false
